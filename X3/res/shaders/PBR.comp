// PBR.comp - Physically Based Rendering Compute Shader
// Uses MaterialX-compatible Cook-Torrance BRDF with GGX distribution
//
// Single-bounce direct lighting with image-based lighting from skybox

#version 460 core

layout (local_size_x = 8, local_size_y = 4, local_size_z = 1) in;

// Include shared modules
#include "include/common.glsl"
#include "include/bindings.glsl"
#include "include/ray_tracing.glsl"
#include "include/shadows.glsl"
#include "include/lighting.glsl"
#include "include/material_sampling.glsl"
#include "include/mx_pbr.glsl"

// Debug visualization helpers
vec3 IntersectionsToRgb(uint intersections, uint cutoff) {
    float t = clamp(float(intersections) / max(1.0, float(cutoff)), 0.0, 1.0);
    float w = 380.0 + 370.0 * t;
    vec3 color;
    if (w <= 380.0) { color = vec3(0.0); }
    else if (w <= 440.0) { color = vec3((440.0 - w) / 60.0 / 3.0, 0.0, 0.8); }
    else if (w <= 490.0) { color = vec3(0.0, (w - 440.0) / 50.0, 1.0); }
    else if (w <= 510.0) { color = vec3(0.0, 1.0, (510.0 - w) / 20.0); }
    else if (w <= 580.0) { color = vec3((w - 510.0) / 70.0, 1.0, 0.0); }
    else if (w <= 645.0) { color = vec3(1.0, (645.0 - w) / 65.0, 0.0); }
    else { color = vec3(1.0, 0.0, 0.0); }
    return pow(color, vec3(GAMMA));
}

void main() {
    // Get texel coordinates
    ivec2 texelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(rayTracingTexture);

    // Bounds check
    if (texelCoords.x >= dims.x || texelCoords.y >= dims.y) {
        return;
    }

    // Map to normalized coordinates
    float x = float(texelCoords.x * 2 - dims.x) / float(dims.x);
    float y = float(texelCoords.y * 2 - dims.y) / float(dims.x); // Use dims.x to maintain aspect ratio

    // Setup camera ray
    Ray ray;

    // Transform ray origin from camera local to world space
    vec4 rayOriginHomogeneous = u_CameraTransform * vec4(0.0, 0.0, 0.0, 1.0);
    ray.origin = rayOriginHomogeneous.xyz / rayOriginHomogeneous.w;

    // Transform ray direction to world space
    vec3 rayDirectionLocal = vec3(x, y, u_FocalLength);
    ray.dir = normalize(mat3(u_CameraTransform) * rayDirectionLocal);

    // DEBUG TEST: Output solid cyan to verify shader is running
    // Comment out this line after testing:
    // imageStore(rayTracingTexture, texelCoords, vec4(0.0, 1.0, 1.0, 1.0)); return;

    // Trace primary ray
    CheckRayCollision(ray);

    vec3 pixelColor;

    if (ray.t < INF_T) {
        // Hit something - shade the surface
        vec3 hitPoint = ray.origin + ray.dir * ray.t;
        vec3 V = -ray.dir; // View direction (toward camera)

        // Get material and extract PBR parameters
        Material mat = MaterialBuffer[ray.materialIdx];
        PBRParams params = GetPBRParams(mat, ray.uv, ray.normal);

        // Compute full PBR shading
        pixelColor = mx_shade_pbr(params, hitPoint, V);

        // Tone mapping (Reinhard)
        pixelColor = pixelColor / (pixelColor + vec3(1.0));

        // Gamma correction
        pixelColor = pow(pixelColor, vec3(1.0 / 2.2));
    } else {
        // Miss - sample skybox
        pixelColor = GetSkyboxLight(ray.dir);
    }

    // Debug modes
    if (u_DebugMode == 1) {
        pixelColor = IntersectionsToRgb(g_AabbIntersectionCount, u_AabbHeatmapCutoff);
    } else if (u_DebugMode == 2) {
        pixelColor = IntersectionsToRgb(g_TriIntersectionCount, u_TriHeatmapCutoff);
    }

    // Output (no accumulation for PBR - single frame)
    imageStore(rayTracingTexture, texelCoords, vec4(pixelColor, 1.0));
}
